set_global_assignment -name VERILOG_MACRO "USE_QSPI=0"
set_global_assignment -name VERILOG_MACRO "DUAL_SDRAM=0"
set_global_assignment -name VERILOG_MACRO "I2S_AUDIO=1"
set_global_assignment -name VERILOG_MACRO "I2S_AUDIO_HDMI=0"
